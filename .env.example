PORT=3000
# Leave empty for local SQLite. On Render, set the internal PostgreSQL connection URL.
DATABASE_URL=
APP_BASE_URL=http://localhost:3000
SP_ENTITY_ID=urn:storeops:local
JIT_ENABLED=true
# From Auth0 > Application > Addons > SAML2 Web App > Usage
IDP_SSO_URL=
IDP_ISSUER=
IDP_CERT_PATH=config/auth0-signing.pem
# For hosted deployments, paste the certificate contents into IDP_CERT_PEM instead.
IDP_CERT_PEM=
# Generated locally by ./scripts/local.sh setup-scim; do not publish its value.
SCIM_TOKEN=
